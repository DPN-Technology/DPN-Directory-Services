# NO passwords or private keys in this file.
DPN_DS_MODE=samba
DPN_DS_REALM=corp.example.com
DPN_DS_CONTROLLER=dc01.corp.example.com
DPN_DS_ENABLE_DRS=false
# Lab token mode by default. Configure OIDC, then set runtime to production.
DPN_DS_RUNTIME_ENV=lab
DPN_DS_AUTH_MODE=legacy
# DPN_DS_OIDC_ISSUER=https://idp.example.com/realms/dpn
# DPN_DS_OIDC_AUDIENCE=dpn-directory-services
# DPN_DS_OIDC_PUBLIC_KEY_FILE=/etc/dpn-ds/issuer-public.pem
# DPN_DS_OIDC_MFA_AMR=mfa
# DPN_DS_OIDC_MAX_TOKEN_AGE_SECONDS=900
# For credential files, use systemd LoadCredential and set paths in a secure unit drop-in.
# DPN_DS_LDAP_BIND_USER=svc-dpnds@corp.example.com
# DPN_DS_LDAP_PASSWORD_FILE=/run/credentials/dpn-ds.service/ldap_password
# DPN_DS_LDAP_CA_FILE=/etc/ssl/certs/ad-ca.pem
# DPN_DS_KRB_PRINCIPAL=svc-dpnds@CORP.EXAMPLE.COM
# DPN_DS_KRB_KEYTAB_FILE=/run/credentials/dpn-ds.service/keytab
