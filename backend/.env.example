# Required for all authenticated /api/v1 requests. Generate your own random token.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DPN_DS_API_TOKEN=
# Set to demo explicitly for fake evaluation data, otherwise samba (real local CLI).
DPN_DS_MODE=demo
DPN_DS_REALM=corp.example.com
DPN_DS_CONTROLLER=dc01.corp.example.com
# Comma separated exact allowed browser origins; blank disables cross-origin API access.
DPN_DS_CORS_ORIGINS=
# OIDC-issued access-token validation is supported, but sign-in/PKCE happens in the IdP.
# Legacy mode is lab-only. Production mode refuses legacy authentication.
DPN_DS_RUNTIME_ENV=lab
DPN_DS_AUTH_MODE=legacy
# OIDC mode requires: HTTPS issuer, dedicated API audience, pinned RSA public PEM,
# issuer-enforced MFA via amr, short-lived access tokens and dpn_roles claim.
# DPN_DS_OIDC_ISSUER=https://sso.example.com/realms/dpn
# DPN_DS_OIDC_AUDIENCE=dpn-directory-services
# DPN_DS_OIDC_PUBLIC_KEY_FILE=/etc/dpn-ds/public-signing-key.pem
# DPN_DS_OIDC_MFA_AMR=mfa
# DPN_DS_OIDC_MAX_TOKEN_AGE_SECONDS=900
